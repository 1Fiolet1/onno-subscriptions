# Copy to .env and replace all CHANGE_ME values before starting the app.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=onno_subscriptions
POSTGRES_USER=onno
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
ONNO_ADMIN_USERNAME=admin
ONNO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ONNO_REMEMBER_ME_KEY=CHANGE_ME_RANDOM_STABLE_KEY
# Calendar dates for subscription status updates.
APP_TIME_ZONE=Europe/Moscow
